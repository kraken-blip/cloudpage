#!/usr/bin/env bash
set -euo pipefail
umask 077
if [[ $(uname -s) != Linux || $EUID != 0 ]]; then
  printf '%s\n' 'Запустите этот файл от root на Linux.' >&2
  exit 1
fi
workdir=$(mktemp -d)
trap 'rm -rf -- "$workdir"' EXIT
